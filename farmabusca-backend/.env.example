NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000
AUTH_RATE_LIMIT=30
ASSISTANT_RATE_LIMIT=10

JWT_SECRET=substitua-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmabusca
DB_USER=postgres
DB_PASSWORD=substitua-esta-senha
DB_SSL=false
DB_SYNC_ALTER=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador FarmaBusca
ADMIN_PHONE=

# Contas fictícias criadas por `npm run demo:seed`. Defina palavras-passe fortes e exclusivas.
DEMO_ADMIN_EMAIL=admin.demo@example.test
DEMO_ADMIN_PASSWORD=
DEMO_PATIENT_EMAIL=paciente.demo@example.test
DEMO_PATIENT_PASSWORD=
DEMO_PHARMACY_EMAIL=farmacia.demo@example.test
DEMO_PHARMACY_PASSWORD=
DEMO_PENDING_PHARMACY_EMAIL=farmacia.pendente@example.test
DEMO_PENDING_PHARMACY_PASSWORD=
DEMO_SECOND_PHARMACY_EMAIL=farmacia.secundaria@example.test
DEMO_SECOND_PHARMACY_PASSWORD=
DEMO_MAVOTA_PHARMACY_PASSWORD=
DEMO_MATOLA_PHARMACY_PASSWORD=

# Pagamentos. Use "mock" durante os testes e "mpesa" apenas com credenciais oficiais.
PAYMENT_PROVIDER_MODE=mock
MPESA_BASE_URL=
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ORIGIN=

# Assistente Gemini. A chave existe somente no backend.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
